{
  "name": "yup-phone",
  "version": "2.0.0",
  "description": "Phone number validation for Yup 0.32 and 1.x using libphonenumber-js.",
  "main": "dist/yup-phone.cjs.js",
  "module": "dist/yup-phone.esm.mjs",
  "types": "dist/index.d.ts",
  "unpkg": "dist/yup-phone.umd.min.js",
  "jsdelivr": "dist/yup-phone.umd.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/yup-phone.esm.mjs",
      "require": "./dist/yup-phone.cjs.js",
      "default": "./dist/yup-phone.esm.mjs"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhisekp/yup-phone.git"
  },
  "author": {
    "name": "Abhisek Pattnaik",
    "email": "abhisekp@engineer.com",
    "url": "https://about.me/abhisekp"
  },
  "bugs": {
    "url": "https://github.com/abhisekp/yup-phone/issues"
  },
  "homepage": "https://yup-phone.js.org",
  "license": "MIT",
  "keywords": [
    "yup",
    "phone",
    "yup-phone",
    "validation",
    "schema",
    "libphonenumber-js"
  ],
  "runkitExampleFilename": "example.js",
  "files": [
    "dist",
    "example.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "jest --runInBand",
    "test:types": "tsc --singleThreaded --noEmit -p tests/types/tsconfig.json",
    "test:package": "node scripts/test-package.mjs",
    "test:baseline": "node scripts/test-baseline.mjs",
    "typecheck": "tsc --singleThreaded --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "node benchmarks/phone.mjs",
    "release:publish": "node scripts/publish.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run test:types && npm run test:package",
    "prepack": "npm run build",
    "preversion": "npm run check"
  },
  "peerDependencies": {
    "yup": "^0.32.11 || ^1.0.0"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.14"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "google-libphonenumber": "^3.2.47",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "rollup": "^4.64.0",
    "typescript": "^7.0.2",
    "yup": "^1.7.1"
  }
}
